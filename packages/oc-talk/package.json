{
  "name": "oc-talk",
  "version": "0.4.0",
  "description": "Cross-session talk for any OpenCode harness: send one message into a peer session and read what it said.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "session",
    "sessions",
    "agent",
    "messaging"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-collections.git",
    "directory": "packages/oc-talk"
  },
  "homepage": "https://github.com/nathwn12/oc-collections/tree/main/packages/oc-talk",
  "bugs": "https://github.com/nathwn12/oc-collections/issues",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check src/transport.mjs && node --check src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "prepublishOnly": "node ../../scripts/check-version-cell.mjs . && bun run check && bun run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.6"
  }
}
