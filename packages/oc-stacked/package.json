{
  "name": "oc-stacked",
  "version": "0.4.0",
  "description": "A three-rung agent stack for OpenCode: one lead, a fresh employee per seam, and an auditor who wrote none of it. The owner is the CEO; the lead speaks for them. Local-first, zero MCP, Windows-native.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "bin": {
    "stack": "./bin/stack.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "bin",
    "lib",
    "skills",
    "agents",
    "roles",
    "routing.json",
    "commands",
    "scripts",
    "SOUL.md",
    "SOURCES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs --jobs",
    "check:serial": "node scripts/check.mjs",
    "prepublishOnly": "node scripts/check.mjs --jobs",
    "install:local": "node scripts/install.mjs",
    "uninstall:local": "node scripts/install.mjs --remove"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "orchestration",
    "subagents",
    "skills"
  ],
  "private": true
}
