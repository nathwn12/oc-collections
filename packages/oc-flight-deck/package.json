{
  "name": "oc-flight-deck",
  "version": "0.24.0",
  "description": "Live cost, token, cache and context telemetry for every OpenCode session in your sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tui",
    "telemetry",
    "cost",
    "tokens",
    "typescript",
    "tooling",
    "session"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-collections.git",
    "directory": "packages/oc-flight-deck"
  },
  "homepage": "https://github.com/nathwn12/oc-collections/tree/main/packages/oc-flight-deck",
  "bugs": "https://github.com/nathwn12/oc-collections/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./src/tui/index.tsx",
      "import": "./dist/tui/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "flight-deck.example.jsonc",
    "flight-deck.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "INSTALL.md",
    "assets",
    "docs/GUIDE.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "compile": "bun scripts/build.ts",
    "check": "bun run typecheck && bun test",
    "check:dist": "bun run compile && git diff --exit-code -- dist",
    "prepublishOnly": "node ../../scripts/check-version-cell.mjs . && bun run check && bun run compile"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@opentui/core": "^0.9.7",
    "@opentui/solid": "^0.9.7",
    "@types/bun": "^1.4.5",
    "solid-js": "1.9.19",
    "string-width": "7.2.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  }
}
