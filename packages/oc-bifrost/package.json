{
  "name": "@nathwn12/oc-bifrost",
  "version": "1.6.13",
  "description": "The rainbow bridge for OpenCode plugins — run V1-era plugin hooks on the OpenCode V2 runtime; unmapped hooks are refused loudly instead of silently dropped.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "compatibility",
    "v1",
    "v2",
    "adapter",
    "bridge"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-collections.git",
    "directory": "packages/oc-bifrost"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "assets",
    "docs/GUIDE.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "PROOF.md",
    "VERIFIED-PLUGINS.md",
    "CONTRIBUTING.md",
    "skills",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js",
    "check": "npm run typecheck && npm run compile && npm run test",
    "vendor:update": "node scripts/vendor-update.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.1 <3"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bugs": "https://github.com/nathwn12/oc-collections/issues",
  "homepage": "https://github.com/nathwn12/oc-collections/tree/main/packages/oc-bifrost"
}
