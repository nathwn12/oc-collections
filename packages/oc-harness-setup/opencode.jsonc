{
  // oc-harness-setup base config: a general OpenCode starter. The
  // orchestrator dispatches, workers own artifacts, state/ is the ledger,
  // and the doctor grades 18 derived laws. Stable runtime policy lives here;
  // behavior lives beside it in agents/, commands/, skills/, and reference/
  // for smaller, hot-reloadable artifacts. Skill loading is fail-closed to
  // the 6 local IDs.
  //
  // This is the oc-harness-setup base config; the installer preserves your
  // model/providers/mcp/plugins.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  // Formatting OFF (measured 2026-10-14): an object value ENABLES every built-in
  // (off by default); a formatter silently rewrites bytes after write/edit/patch, so `cargo fmt` / `ruff format` stay manual.
  "formatter": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".venv/**",
      "__pycache__/**",
      "**/.opencode/state/**",
      "[.]secrets/**",
      "**[.]secrets/**",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "service.json",
      "**/service.json",
      "cli.json",
      "**/cli.json",
      "**/*.pem",
      "**/*.key",
      "**/*.pfx",
      "**/id_rsa*",
      "**/.netrc",
      "**/.npmrc",
      "**/credentials*",
      "**/opencode.db",
      "**/opencode.db-*"
    ]
  },
  "websearch": {
    "provider": "random"
  },
  "references": {
    "orchestration": {
      "path": "~/.config/opencode/reference",
      "description": "Harness references - session loop, delegation, model catalog, hygiene."
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/*",
      "effect": "allow"
    },
    // Policy edits require approval; scoped writer agents may override this
    // only for their owned artifacts in their own frontmatter.
    {
      "action": "edit",
      "resource": "*.config/opencode/*",
      "effect": "ask"
    },
    // Shell runs unattended by default. Destructive and irreversible commands
    // ask while you are present; the hard denies further down survive --auto.
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*Remove-Item*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "del *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rmdir *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rd *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "erase *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "format *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*shutdown*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*Stop-Computer*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*Restart-Computer*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -D*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git filter-repo*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git filter-branch*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reflog expire*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git gc*prune*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh repo delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*cmd /c*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*Invoke-Expression*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*EncodedCommand*",
      "effect": "ask"
    },
    // Guardrail: shell file-writing is the documented bypass of the edit model
    // (it corrupted an artifact once). Make it visible instead of silent.
    {
      "action": "shell",
      "resource": "*Set-Content*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*Out-File*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*Add-Content*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*New-Item*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*ocdbc*vacuum*",
      "effect": "ask"
    },
    // Hard stops. `ask` is auto-approved under --auto, so `deny` is the only
    // gate that holds while you are away. Keep this set minimal and last.
    {
      "action": "shell",
      "resource": "*Format-Volume*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*Clear-Disk*",
      "effect": "deny"
    },
    // Credential-bearing paths: never read, edit, list, or shell. cli.json is a
    // legitimate config file, so it asks rather than denying.
    {
      "action": "external_directory",
      "resource": "*secrets*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*secrets*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*secrets*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*secrets*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*service.json*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*service.json*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*service.json*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*service.json*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*cli.json*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*cli.json*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*cli.json*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*cli.json*",
      "effect": "ask"
    },
    // No external or compatibility-sourced skill may load in OpenCode.
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "close",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "evolve",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "fast",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "goal",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "search",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "swarm",
      "effect": "allow"
    }
  ],
  // Hard tool.use denies in the current V2 shape (action "tool.use",
  // resource "<tool>:<glob>"). The installer owns this block outright
  // (INSTALL_OWNED) so it always wins the merge — an adopter config can
  // never soften it.
  "policies": [
    {
      "action": "tool.use",
      "resource": "read:*.env",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.env.*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*secrets*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*secrets*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.env",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.env.*",
      "effect": "deny"
    }
  ]
}
